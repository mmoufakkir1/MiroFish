# ===== Primary LLM Provider (OpenRouter) =====
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=your_preferred_openrouter_model_here

# Examples:
# LLM_MODEL_NAME=anthropic/claude-3.5-sonnet
# LLM_MODEL_NAME=google/gemini-pro
# LLM_MODEL_NAME=meta-llama/llama-3-70b-instruct

# ===== Local Model Provider (Fallback / Auto-Switch) =====
# When LOCAL_MODELS_ENABLED=true, the app will prefer your local model.
# When false, it will use OpenRouter first.
LOCAL_MODELS_ENABLED=false
LOCAL_LLM_API_KEY=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=deepseek-r1:14b

# Examples:
# LOCAL_LLM_MODEL_NAME=deepseek-r1:14b
# LOCAL_LLM_MODEL_NAME=qwen2.5-coder:7b
# LOCAL_LLM_MODEL_NAME=llama3.1:8b-instruct

# ===== ZEP Memory Graph Configuration =====
ZEP_API_KEY=your_zep_api_key_here

# ===== LLM Acceleration Configuration (Optional) =====
# Remove these lines entirely if you are not using acceleration.
LLM_BOOST_API_KEY=your_openrouter_boost_api_key_here
LLM_BOOST_BASE_URL=https://openrouter.ai/api/v1
LLM_BOOST_MODEL_NAME=your_boost_model_here

LOCAL_LLM_BOOST_API_KEY=local
LOCAL_LLM_BOOST_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_BOOST_MODEL_NAME=deepseek-r1:14b
