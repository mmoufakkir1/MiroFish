# ===== Primary LLM Provider (OpenRouter) =====
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=your_preferred_openrouter_model_here

# Example:
# LLM_MODEL_NAME=anthropic/claude-3.5-sonnet
# LLM_MODEL_NAME=google/gemini-pro
# LLM_MODEL_NAME=meta-llama/llama-3-70b-instruct

# ===== Local Model Provider (Fallback / Auto-Switch) =====
# When LOCAL_MODELS_ENABLED=true, your app will try local models first.
# When false, it will use OpenRouter unless local is unavailable.
LOCAL_MODELS_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL_NAME=deepseek-r1:14b

# Example:
# LOCAL_LLM_MODEL_NAME=deepseek-r1:14b
# LOCAL_LLM_MODEL_NAME=qwen2.5-coder:7b
# LOCAL_LLM_MODEL_NAME=llama3.1:8b-instruct

# ===== ZEP Memory Graph Configuration =====
ZEP_API_KEY=your_zep_api_key_here

# ===== LLM Acceleration Configuration (Optional) =====
# Remove these three lines entirely if you are NOT using acceleration
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

LOCAL_LLM_BOOST_API_KEY=local
LOCAL_LLM_BOOST_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_BOOST_MODEL_NAME=deepseek-r1:14b

# Example:
#LLM_BOOST_API_KEY=boost_xxx_your_api_key_here
#LLM_BOOST_BASE_URL=https://api.fastllmprovider.com/v1
#LLM_BOOST_MODEL_NAME=fast-llm-32b-instruct

#example local
#LLM_BOOST_API_KEY=local
#LLM_BOOST_BASE_URL=http://localhost:11434/v1
#LLM_BOOST_MODEL_NAME=deepseek-r1:14b
